# Veri kaynağı anahtarları. Bu dosyayı .env olarak kopyalayın; .env repoya girmez.
#
# Hangisi kullanılır: API_FOOTBALL_KEY varsa ve hesap ücretli plandaysa API-Football, aksi halde Highlightly.
# API-Football anahtarını yalnızca kendi bilgisayarınızdaki bu dosyaya yazın. Bulut/CI gibi paylaşımlı IP'li
# ortamlarda kullanmayın: API-Football bu adreslerden gelen istekleri engelleyebiliyor.
API_FOOTBALL_KEY=
HIGHLIGHTLY_KEY=
# API-Football anahtarı olsa bile Highlightly'yi zorlamak için:
# DATA_PROVIDER=highlightly
# PORT=8787
# Canlı veri yenileme aralığı (saniye). Boşsa kaynağa ve plana göre seçilir:
# ücretsiz 180, API-Football ücretli 15, Highlightly ücretli 60.
# LIVE_TTL=

# --- Koruma (isteğe bağlı; varsayılanlar parantez içinde) ---
# IP başına dakikadaki istek sayısı ve patlama (120 / 60)
# RATE_PER_MIN=120
# RATE_BURST=60
# Bilinmeyen takım/maç numarası için kaynağa gitme bütçesi: IP başına ve sunucu genelinde saatte (20 / 60)
# COLD_PER_IP=20
# COLD_GLOBAL=60
# Günlük kotadan son kaç istek yalnızca canlı skor yenilemesine ayrılsın (10)
# QUOTA_RESERVE=10
# Bellekte tutulacak en çok önbellek kaydı (4000; disk kopyası kalır, 45 günden eski dosyalar silinir)
# CACHE_MAX_ENTRIES=4000

# Gizlilik sayfasında (/gizlilik) gösterilecek iletişim e-postası (isteğe bağlı)
# CONTACT_EMAIL=

# Bildirimler (Firebase Cloud Messaging): Firebase konsolu → Proje ayarları → Hizmet hesapları → Yeni özel anahtar oluştur.
# İnen JSON dosyasını repoya KOYMA. Yerelde dosya yolunu ver; Render'da JSON'un base64 halini değişken olarak gir.
# FIREBASE_SERVICE_ACCOUNT_FILE=/Users/.../tribun-firebase.json
# FIREBASE_SERVICE_ACCOUNT=
