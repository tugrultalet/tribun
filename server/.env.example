# Veri kaynağı anahtarları. Bu dosyayı .env olarak kopyalayın; .env repoya girmez.
#
# Hangisi kullanılır: API_FOOTBALL_KEY varsa ve hesap ücretli plandaysa API-Football, aksi halde Highlightly.
# API-Football anahtarını yalnızca kendi bilgisayarınızdaki bu dosyaya yazın. Bulut/CI gibi paylaşımlı IP'li
# ortamlarda kullanmayın: API-Football bu adreslerden gelen istekleri engelleyebiliyor.
API_FOOTBALL_KEY=
HIGHLIGHTLY_KEY=
# API-Football anahtarı olsa bile Highlightly'yi zorlamak için:
# DATA_PROVIDER=highlightly
# PORT=8787
# Canlı veri yenileme aralığı (saniye). Boşsa kaynağa ve plana göre seçilir:
# ücretsiz 180, API-Football ücretli 15, Highlightly ücretli 60.
# LIVE_TTL=
